# ---------------------------------------------------------------------------
# Private API - environment configuration
# Copy this file to `.env` and replace every placeholder value.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------------

APP_NAME=Private API
DEBUG=false

# --- Security switches ------------------------------------------------------
# Both default to true. Disable ONLY for local development and never in production.
# AUTHENTICATION_ENABLED=false  -> endpoints stop requiring a bearer token and every
#                                  request is served as AUTH_BYPASS_USERNAME.
# AUTHORIZATION_ENABLED=false   -> every RBAC permission check passes.
AUTHENTICATION_ENABLED=true
AUTHORIZATION_ENABLED=true
AUTH_BYPASS_USERNAME=superadmin

# --- JWT -------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-refresh-token-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# --- Database --------------------------------------------------------------
# SQLite files (db + -wal + -shm) live in database/, which is created automatically.
DATABASE_URL=sqlite:///./database/private_api.db

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Bootstrap superadmin (created on first start only) ---------------------
FIRST_SUPERADMIN_USERNAME=superadmin
FIRST_SUPERADMIN_EMAIL=superadmin@example.com
FIRST_SUPERADMIN_PASSWORD=replace-with-a-strong-password
